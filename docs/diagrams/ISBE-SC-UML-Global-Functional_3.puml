@startuml
title Arquitectura de SC ISBE

skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}
skinparam linetype polyline
hide empty members

' === CORE ===
package "Core" {
    class Initializable <<(A,#228b22) abstract contract>>
    class Common <<(A,#228b22) abstract contract>>
    class LibCommon << (L,#FF7700) library >>
    class ISBEContext <<(A,#228b22) abstract contract>>
    class AccessControlInternal <<(A,#228b22) abstract contract>> #lightblue
    class PauseInternalCommon <<(A,#228b22) abstract contract>> #FFDEAD
    class OwnableInternal <<(A,#228b22) abstract contract>> #lightgreen
    class ERC165Internal <<(A,#228b22) abstract contract>>
    class Context <<(A,#228b22) abstract contract>>

    Common --|> Initializable
    Common --|> ERC165Internal
    Common --|> AccessControlInternal
    Common --|> OwnableInternal
    Common --|> PauseInternalCommon
    PauseInternalCommon --|> ISBEContext
    OwnableInternal --|> ISBEContext
    ISBEContext --|> Context
    AccessControlInternal --|> LibCommon
}


' === ERC20 ===
package "ERC20" {
    class IERC20 <<(I,#FFD700) interface>> #FFB6C1
    class IERC20Metadata <<(I,#FFD700) interface>> #FFB6C1
    class IERC20Isbe <<(I,#FFD700) interface>> #FFB6C1
    class IERC20Burnable <<(I,#FFD700) interface>> #FFB6C1
    class IERC20Capped <<(I,#FFD700) interface>> #FFB6C1
    class IERC20Controller <<(I,#FFD700) interface>> #FFB6C1
    class IERC20Snapshot <<(I,#FFD700) interface>> #FFB6C1

    class ERC20 <<(A,#228B22) abstract contract>> #FFB6C1
    class ERC20Facet <<(C,#1E90FF) contract>> #FFB6C1
    class ERC20Internal <<(A,#228B22) abstract contract>> #FFB6C1
    class ERC20InternalCommon <<(A,#228B22) abstract contract>> #FFB6C1

    class ERC20Burnable <<(A,#228B22) abstract contract>> #FFB6C1
    class ERC20BurnableFacet <<(C,#1E90FF) contract>> #FFB6C1

    class ERC20Capped <<(A,#228B22) abstract contract>> #FFB6C1
    class ERC20CappedFacet <<(C,#1E90FF) contract>> #FFB6C1
    class ERC20CappedInternal <<(A,#228B22) abstract contract>> #FFB6C1

    class ERC20Controller <<(A,#228B22) abstract contract>> #FFB6C1
    class ERC20ControllerFacet <<(C,#1E90FF) contract>> #FFB6C1

    class ERC20Snapshot <<(A,#228B22) abstract contract>> #FFB6C1
    class ERC20SnapshotFacet <<(C,#1E90FF) contract>> #FFB6C1
    class ERC20SnapshotInternal <<(A,#228B22) abstract contract>> #FFB6C1

    ERC20 --|> IERC20Isbe
    IERC20Isbe --|> IERC20
    IERC20Isbe --|> IERC20Metadata
    ERC20 --|> ERC20InternalCommon
    ERC20InternalCommon --|> ERC20SnapshotInternal
    ERC20InternalCommon --|> ERC20CappedInternal
    ERC20Internal --|> Common
    ERC20Facet --|> ERC20

    ERC20Burnable --|> IERC20Burnable
    ERC20Burnable --|> ERC20InternalCommon
    ERC20BurnableFacet --|> ERC20Burnable

    ERC20Capped --|> IERC20Capped
    ERC20Capped --|> ERC20InternalCommon
    ERC20CappedFacet --|> ERC20Capped
    ERC20CappedInternal --|> ERC20Internal

    ERC20Controller --|> IERC20Controller
    ERC20Controller --|> ERC20InternalCommon
    ERC20ControllerFacet --|> ERC20Controller

    ERC20Snapshot --|> IERC20Snapshot
    ERC20Snapshot --|> ERC20InternalCommon
    ERC20SnapshotFacet --|> ERC20Snapshot
    ERC20SnapshotInternal --|> ERC20Internal
}

' === ERC3643 ===
package "ERC3643" {

    class ERC3643InternalCommon <<(A,#228B22) abstract contract>> #E6E6FA

     ' --- Control ---
    class IERC3643Control <<(I,#FFD700) interface>> #E6E6FA
    class ERC3643Control <<(A,#228B22) abstract contract>> #E6E6FA
    class ERC3643ControlFacet <<(C,#1E90FF) contract>> #E6E6FA

    ERC3643ControlFacet --|> ERC3643Control
    ERC3643Control --|> IERC3643Control 
    ERC3643Control --|> ERC3643InternalCommon    

    ' --- Metadata ---
    class IERC3643Metadata <<(I,#FFD700) interface>> #E6E6FA
    class ERC3643MetadataInternal <<(A,#228B22) abstract contract>> #E6E6FA
    class ERC3643Metadata <<(A,#228B22) abstract contract>> #E6E6FA
    class ERC3643MetadataFacet <<(C,#1E90FF) contract>> #E6E6FA

    ERC3643MetadataFacet --|> ERC3643Metadata 
    ERC3643Metadata --|> IERC3643Metadata 
    ERC3643Metadata --|> ERC3643InternalCommon    
    ERC3643InternalCommon --|> ERC3643MetadataInternal 
    ERC3643MetadataInternal --|> ERC20InternalCommon 


    ' --- Freeze ---
    class IERC3643Freeze <<(I,#FFD700) interface>> #E6E6FA
    class ERC3643FreezeInternal <<(A,#228B22) abstract contract>> #E6E6FA
    class ERC3643Freeze <<(A,#228B22) abstract contract>> #E6E6FA
    class ERC3643FreezeFacet <<(C,#1E90FF) contract>> #E6E6FA

    ERC3643FreezeFacet --|> ERC3643Freeze
    ERC3643Freeze --|> IERC3643Freeze
    ERC3643Freeze --|> ERC3643InternalCommon    
    ERC3643InternalCommon --|> ERC3643FreezeInternal
    ERC3643FreezeInternal --|> Common
    
    ' --- Regulatory Infrastructure ---
    class IERC3643Regulatory <<(I,#FFD700) interface>> #E6E6FA
    class ERC3643RegulatoryInternal <<(A,#228B22) abstract contract>> #E6E6FA
    class ERC3643Regulatory <<(A,#228B22) abstract contract>> #E6E6FA
    class ERC3643RegulatoryFacet <<(C,#1E90FF) contract>> #E6E6FA
    
    ERC3643RegulatoryFacet --|> ERC3643Regulatory
    ERC3643Regulatory --|> IERC3643Regulatory
    ERC3643Regulatory --|> ERC3643InternalCommon    
    ERC3643InternalCommon --|> ERC3643RegulatoryInternal
    ERC3643RegulatoryInternal --|> Common

    
}
@enduml