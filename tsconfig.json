{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "strict": true,
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "baseUrl": ".",
        "paths": {
            "@scripts/*": ["scripts/*"],
            "@tasks/*": ["tasks/*"],
            "@utils/*": ["utils/*"],
            "@test/*": ["test/*"],
            "@types/*": ["types/*"]
        }
    }
}
